# Attendance Backend Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database (Supabase/PostgreSQL)
# For homelab: DB_HOST=supabase-db (on proxynet), DB_PORT=5432
# For local dev: DB_HOST=localhost, DB_PORT=5432
DB_HOST=supabase-db
DB_PORT=5432
DB_NAME=postgres
DB_USER=supabase_admin
DB_PASSWORD=7567@Hetp
DB_SSL=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Metronome
METRONOME_INTERVAL_MS=3000
METRONOME_TOKEN_LENGTH=6
METRONOME_TOKEN_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
METRONOME_LOOKAHEAD_TOKENS=2

# Judge
JUDGE_MAX_LATENCY_MS=250
JUDGE_TOKEN_VALIDITY_WINDOW_MS=5000