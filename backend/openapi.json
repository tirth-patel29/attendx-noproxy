  "security": [
    {
      "ApiKey": []
    },
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Shared client API key (mint from the Admin console)."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized / invalid API key or token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "success": false,
              "error": {
                "code": "ERR_AUTH_MISSING",
                "message": "Missing or invalid JWT/API Key."
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden (wrong role)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "success": false,
              "error": {
                "code": "ERR_FORBIDDEN",
                "message": "Access required."
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "success": false,
              "error": {
                "code": "ERR_NOT_FOUND",
                "message": "Requested resource or session does not exist."
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "ERR_HW_MISMATCH",
                  "ERR_SIG_INVALID",
                  "ERR_STREAM_DETECTED",
                  "ERR_TOKEN_EXPIRED",
                  "ERR_NONCE_USED",
                  "ERR_NONCE_INVALID",
                  "ERR_AUTH_MISSING",
                  "ERR_FORBIDDEN",
                  "ERR_NOT_FOUND",
                  "ERR_RATE_LIMIT",
                  "ERR_BAD_REQUEST",
                  "ERR_CONFLICT",
                  "ERR_INTERNAL",
                  "ERR_UNAVAILABLE",
                  "ERR_UNKNOWN"
                ]
              },
              "message": {
                "type": "string"
              },
              "latency_ms": {
                "type": "number",
                "description": "Present only for ERR_STREAM_DETECTED."
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "example": {
          "success": false,
          "error": {
            "code": "ERR_STREAM_DETECTED",
            "message": "Stream artifact detected",
            "latency_ms": 310
          }
        }
      }
    }
  },
