    "/api/v1/claim-attendance": {
      "post": {
        "tags": [
          "Attendance / Claim"
        ],
        "summary": "Submit an attendance claim (Gate 1-4 pipeline; HMAC-signed, ≤250ms TTL enforced)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "session_uuid": "uuid",
                "student_uuid": "uuid",
                "token_val": "Ab3d",
                "client_claimed_time": 1720000000123,
                "device_id_hash": "sha256-hex",
                "nonce": "hex",
                "signature": "hmac-hex"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PRESENT",
            "content": {
              "application/json": {
                "example": {
                  "status": "PRESENT",
                  "verification_delta_ms": 87,
                  "ledger_uuid": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "Hardware mismatch (Gate 1)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "ERR_HW_MISMATCH",
                    "message": "Unregistered hardware. Your account is bound to a different physical device."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Forged/corrupted HMAC signature (Gate 4)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "ERR_SIG_INVALID",
                    "message": "Cryptographic rejection. The HMAC signature was forged or corrupted."
                  }
                }
              }
            }
          },
          "406": {
            "description": "Visual token expired/invalid (Gate 3)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "ERR_TOKEN_EXPIRED",
                    "message": "The scanned visual token is expired or invalid."
                  }
                }
              }
            }
          },
          "412": {
            "description": "Proxy stream detected / time drift (Gate 4)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "ERR_STREAM_DETECTED",
                    "message": "Proxy Stream Detected. Photonic intercept lag exceeded the 250ms threshold.",
                    "latency_ms": 310
                  }
                }
              }
            }
          },
          "400": {
            "description": "Anti-replay: nonce consumed (Gate 4)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "ERR_NONCE_USED",
                    "message": "Anti-replay protection triggered. Nonce already consumed."
                  }
                }
              }
            }
          }
        }
      }
    },
