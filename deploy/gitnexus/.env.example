# Absolute path of a dedicated AttendX checkout on the EC2 host.
# GitNexus writes only its generated .gitnexus/ directory beside this checkout.
ATTENDX_REPO_PATH=/srv/attendx-noproxy

# Keep the service loopback-only; access it via an SSH tunnel.
GITNEXUS_PORT=4747
GITNEXUS_WEB_PORT=4173

# HTTPS URL used by group members in their browser. Caddy protects it.
GITNEXUS_PUBLIC_URL=https://gitnexus.example.com

# Generate on the EC2 server, for example: openssl rand -hex 32
# Do not commit the real value.
GITNEXUS_MCP_AUTH_TOKEN=replace-with-a-long-random-secret
