# ============================================================
# Supabase self-host — environment (copy to .env and fill in)
# ============================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Public URL (what the app/browser will call this) ---
# Use the internal docker-network URL that proxycore can reach, or the tunnel URL.
# For local container-to-container you can also use http://supabase-kong:8000
PUBLIC_SITE_URL=https://supabase.atmyhome.tech
GOTRUE_URI_ALLOW_LIST=https://supabase.atmyhome.tech,http://localhost:3000

# --- Auth (GoTrue) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXP=3600
GOTRUE_MAILER_AUTOCONFIRM=true

# Email (used for the student/prof verification emails + OTP flows)
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=Attendance Gateway

# --- Realtime ---
REALTIME_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Kong ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- PostgREST ---
PGRST_DB_SCHEMAS=public,storage,graphql_public

# --- Backup target (absolute path on the host, mount the 500GB WD here) ---
BACKUP_DIR=/mnt/wd/attendance-backups
