# ============================================================================
# AttendX — Production Environment Configuration (AWS EC2 / Cloud VM)
# ----------------------------------------------------------------------------
# Copy this file to .env.production on your EC2 host:
#   cp .env.production.example .env.production
# Then start the stack:
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.ports.yml up -d --build
# ============================================================================

# --- NODE ENVIRONMENT ---
NODE_ENV=production
LOG_LEVEL=info

# --- DATABASE CONFIGURATION ---
# Point to your PostgreSQL container (or managed RDS instance)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=replace-with-a-strong-random-password-min-24-chars
DB_SSL=false

# --- SECURITY & AUTHENTICATION ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-secret-string

# --- INITIAL ADMIN BOOTSTRAP ---
# These are upserted into the database on first boot.
# IMPORTANT: After your initial login to the Admin Console, remove ADMIN_PASSWORD
# so that passwords changed via the web UI remain permanent across restarts.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=InitialAdminPasswordChangeMe123!
ADMIN_NAME=System Administrator

# --- ZERO-TRUST VERIFICATION (JUDGE & METRONOME) ---
# Rotating visual token settings (SRS baseline: 3000ms interval, 4-char base62)
METRONOME_INTERVAL_MS=3000
METRONOME_TOKEN_LENGTH=4
METRONOME_TOKEN_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
METRONOME_LOOKAHEAD_TOKENS=2

# Verification Kill-Window (SRS baseline: 250ms stream detection threshold)
JUDGE_MAX_LATENCY_MS=250
JUDGE_TOKEN_VALIDITY_WINDOW_MS=5000

# --- DOMAIN & CORS CONFIGURATION ---
# Comma-separated domains allowed to connect to Express REST and Socket.IO
CORS_ORIGIN=https://teacher.yourdomain.com,https://admin.yourdomain.com,https://api.yourdomain.com

# Upstream proxy target used by Teacher/Admin Nginx containers
BACKEND_UPSTREAM=backend:3001

# --- HOST PORT PUBLISHING (via docker-compose.ports.yml) ---
BACKEND_PORT=3001
TEACHER_PORT=3000
ADMIN_PORT=3002
